{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "business-empire",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LEADERBOARD", "class_name": "Leaderboard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Leaderboard"] }],
  "observability": { "enabled": true }
}
